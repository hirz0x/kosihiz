# Salin file ini jadi .env.test.local lalu isi nilainya. Jangan commit .env.test.local.
#
# File ini HANYA dibaca oleh tests/*.test.js (lewat tests/_guard.js) — TIDAK dibaca oleh aplikasi
# (next dev/build memakai .env.local, bukan file ini) dan TIDAK ADA fallback ke .env.local kalau
# file ini tidak ada. Dipisah sengaja dari .env.local supaya tes yang membuat/menghapus akun & baris
# data sintetis tidak pernah ikut diam-diam menyasar Supabase produksi hanya karena .env.local
# diarahkan ke sana untuk kebutuhan lain (deploy, dll).
#
# Catatan: beberapa tes login lewat server dev yang sedang jalan di localhost:3000 (yang membaca
# kredensialnya sendiri dari .env.local) sambil langsung memanggil REST Supabase pakai kredensial
# di file INI — supaya kedua sisi konsisten, isi SUPABASE_URL/SUPABASE_SECRET_KEY/ADMIN_USERNAME/
# ADMIN_PASSWORD di sini SAMA dengan yang dipakai server dev yang sedang jalan (dev server itu
# sendiri sebaiknya diarahkan ke project Supabase testing, bukan produksi).

# --- Supabase project KHUSUS testing (bukan produksi) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Daftar SUPABASE_URL yang BOLEH disentuh tes (pisahkan koma kalau lebih dari satu). Kalau kosong,
# atau SUPABASE_URL di atas tidak ada di daftar ini, SEMUA tes di folder tests/ menolak jalan.
TEST_ALLOWED_SUPABASE_URL=

# Kunci Paymenku yang dipakai server dev yang sedang jalan — HARUS BUKAN kunci live (sk_live_...).
# Boleh dikosongkan kalau cuma mau jalankan tes yang tidak menyentuh apa pun soal Paymenku.
PAYMENKU_API_KEY=

# Kredensial admin server dev yang sedang jalan, dipakai tests/markup-bounds.test.js untuk login
# ke /api/admin-login.
ADMIN_USERNAME=
ADMIN_PASSWORD=
