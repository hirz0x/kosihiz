# Salin file ini jadi .env.local lalu isi nilainya. Jangan commit .env.local.

# --- smmsoc.com (provider layanan) ---
# URL API provider. Biarkan seperti ini.
SMMSOC_API_URL=https://smmsoc.com/api/v2
# API key dari akun smmsoc.com kamu (menu API di dashboard mereka).
SMMSOC_API_KEY=

# --- likeo.net (provider layanan kedua) ---
# URL API provider. Biarkan seperti ini.
LIKEO_API_URL=https://likeo.net/api/v2
# API key dari akun likeo.net kamu (menu API di dashboard mereka).
LIKEO_API_KEY=

# --- Admin ---
# Kata sandi untuk masuk ke /admin. Pilih sendiri, minimal 12 karakter.
ADMIN_PASSWORD=
# Opsional. Isi teks apa saja (boleh dikosongkan) untuk mencabut SEMUA sesi admin yang sedang aktif
# tanpa harus ganti password — ganti nilainya lalu deploy ulang kalau curiga cookie sesi admin bocor.
ADMIN_SESSION_EPOCH=

# --- Supabase (login & daftar, nanti) ---
# Project URL dari Supabase: Project Settings > API.
SUPABASE_URL=
# Publishable key dari Supabase (aman dipakai di browser, tapi di sini dipakai di server).
SUPABASE_ANON_KEY=
# Secret key dari Supabase. Hanya di server. Jangan pernah dikirim ke browser atau chat.
SUPABASE_SECRET_KEY=

# Rahasia untuk pengecekan otomatis terjadwal: pesanan (scripts/cron-orders.js) dan status deposit
# Paymenku yang masih "menunggu" (scripts/cron-deposits.js, pages/api/cron/deposits.js). WAJIB
# diisi dengan string acak yang panjang (mis. `openssl rand -hex 32`) -- kalau dikosongkan, SEMUA
# endpoint /api/cron/* menolak semua permintaan (fail-closed, lihat tests/cron-deposits-security.test.js),
# jadi pengecekan terjadwal berhenti total, bukan diam-diam terbuka tanpa otentikasi. Dipakai juga
# sebagai header `Authorization: Bearer <CRON_SECRET>` kalau menjadwalkan lewat scheduler eksternal
# (lihat AUDIT_REPORT.md bagian "Scheduler eksternal").
CRON_SECRET=

# --- Tes keamanan (tests/*.test.js) ---
# CATATAN: tests/*.test.js SEKARANG membaca kredensial dari file TERPISAH, .env.test.local (lihat
# .env.test.example) -- BUKAN dari .env.local ini. Baris TEST_ALLOWED_SUPABASE_URL di bawah ini
# sudah TIDAK dibaca oleh kode apa pun (dipertahankan di sini cuma sebagai riwayat/dokumentasi
# supaya jelas kenapa variabel ini masih dikenal) -- isi yang benar-benar dipakai tes ada di
# .env.test.local, terpisah dari env aplikasi ini supaya tes yang membuat/menghapus data sintetis
# tidak pernah ikut diam-diam menyasar Supabase produksi kalau .env.local ini diarahkan ke sana.
#
# Daftar SUPABASE_URL yang BOLEH disentuh oleh tests/*.test.js (pisahkan koma kalau lebih dari
# satu). Tes-tes itu membuat/menghapus akun & baris data lewat Supabase sungguhan, jadi isi ini
# dengan SUPABASE_URL project Supabase KHUSUS testing (bukan produksi). Kalau kosong, atau SUPABASE_URL
# di atas tidak ada di daftar ini, SEMUA tes di folder tests/ menolak jalan (lihat tests/_guard.js).
TEST_ALLOWED_SUPABASE_URL=


# --- Paymenku (pembayaran deposit) ---
# API key dari dashboard Paymenku. Hanya di server.
PAYMENKU_API_KEY=
# Kode channel pembayaran, contoh: qris (QRIS), bca_va, dana.
PAYMENKU_CHANNEL=qris
# Opsional tapi disarankan: Webhook Secret dari dashboard Paymenku (Settings > Webhook) — BEDA
# dari API key di atas. Kalau diisi, pages/api/paymenku/webhook.js memverifikasi signature
# HMAC-SHA256 yang dikirim Paymenku sebelum memproses notifikasi. Kalau dikosongkan, verifikasi
# ini dilewati (webhook tetap aman lewat re-cek status ke API Paymenku, cuma tanpa lapisan ini).
PAYMENKU_WEBHOOK_SECRET=

# Username admin untuk login di /admin-login.
ADMIN_USERNAME=

# Alamat aplikasi, dipakai untuk link reset password dan kembali dari pembayaran.
APP_URL=http://localhost:3000
